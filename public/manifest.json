{
  "manifest_version": 3,
  "name": "Zuri",
  "version": "1.0.0",
  "description": "Copiloto de leitura e análise de código local e offline alimentado por IA.",
  "permissions": [ "sidePanel", "activeTab", "scripting", "storage", "contextMenus" ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "service_worker": "background.js",
      "js": ["content.js"]
    }
  ],
  "side_panel": {"default_path": "dist/sidepanel.html"},
  "action": {"default_title": "Abrir Zuri"},
  "icons": {"128": "public/icon.png"}
}
