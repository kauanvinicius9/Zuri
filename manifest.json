{
    "manifest_version": 3,
    "name": "Vulcan | Intelligence By Your Side",
    "version": "1.0.0",
    "description": "Intelligence by your side - React widget to local AI productivity",
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "permission": [
        "storage",
        "activeTab"
    ]
}